{# packert generated-header template.
   Render with trim_blocks and lstrip_blocks enabled.
   All decisions (sorting, filtering empty groups/entities, nesting dotted
   names, wire types, sizes, hash) are made in build_layout(); this template
   only formats what the model provides. #}
/*
 * {{ hardware_name }}.h
 * Generated by packert_gen from {{ source }}. Do not edit.
 *
 * Wire format: little-endian, IEEE 754 floats.
 * Decode received bytes with memcpy into these types; do not cast a raw
 * receive buffer to a struct pointer or take pointers to struct members.
 */
#ifndef PACKERT_{{ upper(hardware_name) }}_H
#define PACKERT_{{ upper(hardware_name) }}_H

#include <stddef.h>
#include <stdint.h>
#include "packert/packert.h"

#define {{ upper(hardware_name) }}_LAYOUT_HASH   {{ hash_hex }}u
#define {{ upper(hardware_name) }}_LAYOUT_STRING "{{ canonical }}"

PACKERT_STATIC_ASSERT(sizeof(float) == 4, "packert: float must be 32-bit");
{% if uses_double %}
PACKERT_STATIC_ASSERT(sizeof(double) == 8, "packert: double must be 64-bit on this target");
{% endif %}

{% for dir in directions %}
{% if dir.has_data %}
/* {{ dir.name }} payload: {{ dir.size }} bytes */
typedef struct PACKERT_PACKED {
{% for group in dir.groups %}
  struct {
{% for entity in group.entities %}
    struct {
{% for field in entity.fields %}
{% if existsIn(field, "fields") %}
      struct {
{% for leaf in field.fields %}
        {{ leaf.c_type }} {{ leaf.name }};
{% endfor %}
      } {{ field.name }};
{% else %}
      {{ field.c_type }} {{ field.name }};
{% endif %}
{% endfor %}
    } {{ entity.name }};
{% endfor %}
  } {{ group.name }};
{% endfor %}
} {{ hardware_name }}_{{ dir.name }}_data_t;

PACKERT_STATIC_ASSERT(sizeof({{ hardware_name }}_{{ dir.name }}_data_t) == {{ dir.size }},
                      "{{ hardware_name }}_{{ dir.name }}_data_t size mismatch");

{% endif %}
{% endfor %}
/* Command frame: host -> device */
typedef struct PACKERT_PACKED {
  packert_header_t header;   /*  0: 8 bytes */
  uint32_t host_tx_us;       /*  8: host send time */
  uint32_t reserved;         /* 12: pads payload to 8-byte alignment */
{% if has_command_data %}
  {{ hardware_name }}_command_data_t data;  /* 16 */
{% endif %}
} {{ hardware_name }}_command_t;

{% if has_command_data %}
PACKERT_STATIC_ASSERT(offsetof({{ hardware_name }}_command_t, data) == 16,
                      "{{ hardware_name }}_command_t payload offset");
{% endif %}

/* State frame: device -> host */
typedef struct PACKERT_PACKED {
  packert_header_t header;   /*  0: 8 bytes */
  uint32_t hash;             /*  8: layout hash */
  uint32_t echo_host_tx_us;  /* 12: host_tx_us of the acknowledged command */
  uint32_t device_rx_us;     /* 16: when that command arrived */
  uint32_t device_tx_us;     /* 20: when this frame was sent */
  uint16_t ack_seq;          /* 24: sequence of the acknowledged command */
  uint8_t  status;           /* 26: PACKERT_STATUS_* */
  uint8_t  fault_bits;       /* 27: user-defined */
  uint32_t reserved;         /* 28: pads payload to 8-byte alignment */
{% if has_state_data %}
  {{ hardware_name }}_state_data_t data;    /* 32 */
{% endif %}
} {{ hardware_name }}_state_t;

{% if has_state_data %}
PACKERT_STATIC_ASSERT(offsetof({{ hardware_name }}_state_t, data) == 32,
                      "{{ hardware_name }}_state_t payload offset");
{% endif %}

#endif /* PACKERT_{{ upper(hardware_name) }}_H */
